{
  "envelope": {
    "additionalProperties": false,
    "description": "A published domain event.\n\nImmutable once constructed. The payload is a JSON-serialisable dict; the concrete\nPydantic model for a given type lives in the registry and is applied on read, so a\nconsumer that does not know a type can still forward, archive or replay it.",
    "properties": {
      "causation_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "event_id of the event that directly caused this one",
        "title": "Causation Id"
      },
      "correlation_id": {
        "format": "uuid",
        "title": "Correlation Id",
        "type": "string"
      },
      "event_id": {
        "format": "uuid",
        "title": "Event Id",
        "type": "string"
      },
      "event_type": {
        "description": "sarana.{domain}.{noun}.{verb}",
        "title": "Event Type",
        "type": "string"
      },
      "occurred_at": {
        "format": "date-time",
        "title": "Occurred At",
        "type": "string"
      },
      "payload": {
        "additionalProperties": true,
        "title": "Payload",
        "type": "object"
      },
      "producer": {
        "description": "Service or agent that published this event",
        "title": "Producer",
        "type": "string"
      },
      "replay_of": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Replay Of"
      },
      "replayed_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Replayed At"
      },
      "schema_version": {
        "default": 1,
        "minimum": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "subject": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Primary entity this event is about, e.g. an incident ref",
        "title": "Subject"
      },
      "trace_context": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Trace Context",
        "type": "object"
      }
    },
    "required": [
      "event_type",
      "producer"
    ],
    "title": "EventEnvelope",
    "type": "object"
  },
  "events": {
    "sarana.aid.anomaly.disposed/v1": {
      "additionalProperties": false,
      "description": "A human closed a flag.\n\n`disposition` includes FALSE_POSITIVE because the false-positive rate is a tracked\nmetric reported alongside the detection rate, and it can only be computed if the\noutcome is recorded.",
      "properties": {
        "disposed_at": {
          "format": "date-time",
          "title": "Disposed At",
          "type": "string"
        },
        "disposition": {
          "title": "Disposition",
          "type": "string"
        },
        "flag_id": {
          "format": "uuid",
          "title": "Flag Id",
          "type": "string"
        }
      },
      "required": [
        "flag_id",
        "disposition",
        "disposed_at"
      ],
      "title": "AidAnomalyDisposed",
      "type": "object"
    },
    "sarana.aid.anomaly.flagged/v1": {
      "additionalProperties": false,
      "description": "A pattern warranting review. Never public, and it names no one (ADR-009).\n\nThe rationale is deliberately absent from the event. Flags are private, and an event\nlog is the least private place in the platform.",
      "properties": {
        "detector": {
          "title": "Detector",
          "type": "string"
        },
        "detector_version": {
          "title": "Detector Version",
          "type": "string"
        },
        "flag_id": {
          "format": "uuid",
          "title": "Flag Id",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "subject_id": {
          "format": "uuid",
          "title": "Subject Id",
          "type": "string"
        },
        "subject_type": {
          "title": "Subject Type",
          "type": "string"
        }
      },
      "required": [
        "flag_id",
        "subject_type",
        "subject_id",
        "detector",
        "detector_version",
        "score"
      ],
      "title": "AidAnomalyFlagged",
      "type": "object"
    },
    "sarana.aid.approval.recorded/v1": {
