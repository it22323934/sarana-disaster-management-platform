// Template selection for the warning agent. The label is the template code the published
// catalogue should produce for a hazard at an impact class, or "none" where nothing fits
// and a DMC operator decides. Read off the catalogue and NBRO's escalation points rather
// than off the code, so a change that makes class 4 flood select a warning instead of an
// evacuation order fails this eval.
{"id": "flood-class-0-sends-nothing", "subject_id": "w-01", "input": {"hazard_type": "FLOOD", "impact_class": 0}, "label": {"template_code": "none"}, "expect_human_review": false}
{"id": "flood-class-1-is-below-the-alerting-threshold", "subject_id": "w-02", "input": {"hazard_type": "FLOOD", "impact_class": 1}, "label": {"template_code": "none"}, "expect_human_review": false}
