{
  "name": "@sarana/ts-shared",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "description": "Shared TypeScript for SARANA: API client, zod schemas, i18n catalogue, formatters",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./format": "./src/format/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ./openapi.json -o ./src/api/generated.ts",
    "verify-i18n": "tsx ./scripts/verify-i18n.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "openapi-typescript": "^7.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
