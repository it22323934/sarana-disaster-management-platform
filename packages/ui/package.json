{
  "name": "@sarana/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The SARANA design system: tokens, three-script typography, and the shared component library.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./tokens.css": "./tokens.css",
    "./tokens.nativewind": "./tokens.nativewind.js",
    "./primitives": "./src/primitives/index.ts",
    "./data": "./src/data/index.ts",
    "./domain": "./src/domain/index.ts",
    "./map": "./src/map/index.ts",
    "./forms": "./src/forms/index.ts"
  },
  "files": [
    "src",
    "tokens.css",
    "tokens.nativewind.js"
  ],
  "scripts": {
    "build": "tsc --build && pnpm run tokens:generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:generate": "tsx ./scripts/generate-tokens.ts",
    "test:tokens-sync": "tsx ./scripts/generate-tokens.ts --check",
    "test:contrast": "tsx ./scripts/check-contrast.ts",
    "test:i18n-overflow": "tsx ./scripts/check-i18n-overflow.ts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@sarana/ts-shared": "workspace:*",
    "@tanstack/react-virtual": "^3.13.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0 || ^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "zod": "^3.24.1"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "jsdom": "^25.0.1",
    "maplibre-gl": "^5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.60.0",
    "storybook": "^10.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
