# Copy to .env and fill in for local development. No real secrets belong in this file
# or in any committed file — this is the documented list of every variable, nothing more.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
SARANA_ENV=dev                                  # dev | staging | prod
SARANA_LOG_LEVEL=INFO

# Postgres (one database, schema-per-service — see docs/build-prompts/04-data-model.md)
SARANA_DATABASE_URL=postgresql+asyncpg://sarana_app:sarana_app@localhost:5432/sarana
SARANA_MIGRATOR_DATABASE_URL=postgresql+asyncpg://sarana_migrator:sarana_migrator@localhost:5432/sarana

# Event bus — redis_streams (local) | eventbridge (aws) | in_memory (tests)
SARANA_EVENT_BUS=redis_streams
SARANA_REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally, S3 on AWS — same S3-compatible client either way)
SARANA_S3_ENDPOINT_URL=http://localhost:9000
SARANA_S3_ACCESS_KEY=sarana-dev
SARANA_S3_SECRET_KEY=sarana-dev-secret        # dev-only value, never used outside docker compose
SARANA_S3_MEDIA_BUCKET=sarana-dev-media
SARANA_S3_ANCHORS_BUCKET=sarana-dev-anchors

# Auth (docs/build-prompts/05-auth-rbac.md)
SARANA_JWT_PRIVATE_KEY_PATH=./infra/docker/dev-keys/jwt-private.pem
SARANA_JWT_PUBLIC_KEY_PATH=./infra/docker/dev-keys/jwt-public.pem
SARANA_MSISDN_HMAC_KEY=dev-only-change-me       # dev-only value; real key lives in Secrets Manager

# LLM (docs/build-prompts/12-langgraph-runtime.md) — leave blank to force every agent's
# degraded path, which every agent must support
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Tracing
SARANA_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sarana-dev

# Mail capture (dev only)
SARANA_SMTP_HOST=localhost
SARANA_SMTP_PORT=1025

# ---------------------------------------------------------------------------
# core-api (port 8001)
# ---------------------------------------------------------------------------
SARANA_CORE_API_PORT=8001

# ---------------------------------------------------------------------------
# incident-svc (port 8002)
# ---------------------------------------------------------------------------
SARANA_INCIDENT_SVC_PORT=8002

# ---------------------------------------------------------------------------
# alerting-svc (port 8003)
# ---------------------------------------------------------------------------
SARANA_ALERTING_SVC_PORT=8003

# ---------------------------------------------------------------------------
# ledger-svc (port 8004)
# ---------------------------------------------------------------------------
SARANA_LEDGER_SVC_PORT=8004

# ---------------------------------------------------------------------------
# agent-svc (port 8005)
# ---------------------------------------------------------------------------
SARANA_AGENT_SVC_PORT=8005

# ---------------------------------------------------------------------------
# gov-mock (port 8006)
# ---------------------------------------------------------------------------
SARANA_GOV_MOCK_PORT=8006
SARANA_GOV_MOCK_CHAOS_TIMEOUT_PCT=5
SARANA_GOV_MOCK_CHAOS_ERROR_PCT=5
SARANA_GOV_MOCK_CHAOS_MALFORMED_PCT=5
