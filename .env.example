# =============================================================================
# SARANA - local development environment
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every variable below is REQUIRED unless marked OPTIONAL. Services validate
# their settings at boot and exit with the missing variable name - they never
# fail with a KeyError at request time.
# =============================================================================

# --- Deployment identity -----------------------------------------------------
# One of: local | dev | staging | prod. Drives log format and safety guards.
SARANA_ENV=local
# Free-form instance label that appears in every log line and OTel resource.
SARANA_INSTANCE=laptop

# --- PostgreSQL 16 + PostGIS 3.4 + pgvector ----------------------------------
# One database, schema per service (ADR-002).
POSTGRES_USER=sarana
POSTGRES_PASSWORD=sarana_local_only
POSTGRES_DB=sarana
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async SQLAlchemy DSN used by every service. Host is `postgres` inside compose.
SARANA_DATABASE_URL=postgresql+asyncpg://sarana:sarana_local_only@localhost:5432/sarana
# Sync DSN - Alembic only.
SARANA_DATABASE_URL_SYNC=postgresql+psycopg://sarana:sarana_local_only@localhost:5432/sarana

# --- Redis 7 (Redis Streams = local event bus, ADR-003) ----------------------
SARANA_REDIS_URL=redis://localhost:6379/0
# Consumer group name shared by all subscribers of a service.
SARANA_EVENT_STREAM_PREFIX=sarana

# --- Object storage (MinIO locally, S3 on AWS) -------------------------------
SARANA_S3_ENDPOINT_URL=http://localhost:9000
SARANA_S3_REGION=ap-south-1
SARANA_S3_ACCESS_KEY_ID=sarana_minio
SARANA_S3_SECRET_ACCESS_KEY=sarana_minio_local_only
# Citizen report media (voice notes, photos). Private, encrypted at rest.
SARANA_S3_BUCKET_MEDIA=sarana-media
# Daily Merkle roots of the aid ledger. S3 Object Lock, compliance mode (ADR-005).
SARANA_S3_BUCKET_ANCHOR=sarana-ledger-anchor

# --- Auth (RS256 JWT, file 05) ----------------------------------------------
# PEM keypair. Generate locally with `make keys`. Never reuse across environments.
SARANA_JWT_PRIVATE_KEY_PATH=./infra/docker/dev-keys/jwt-private.pem
SARANA_JWT_PUBLIC_KEY_PATH=./infra/docker/dev-keys/jwt-public.pem
SARANA_JWT_ISSUER=https://sarana.lk
SARANA_JWT_AUDIENCE=sarana-api
SARANA_ACCESS_TOKEN_TTL_SECONDS=900
SARANA_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- OpenTelemetry -----------------------------------------------------------
SARANA_OTLP_ENDPOINT=http://localhost:4317
# OPTIONAL. When false, spans are dropped and no collector connection is made.
SARANA_TRACING_ENABLED=true

# --- OpenAI (agents, file 12 onward) ----------------------------------------
# OPTIONAL until file 12. Agent tests run on recorded fixtures without it.
OPENAI_API_KEY=
# Default reasoning model for agent nodes.
SARANA_LLM_MODEL_DEFAULT=gpt-5.6-terra
# High-volume, low-cost model for bulk classification and dedup candidates.
SARANA_LLM_MODEL_VOLUME=gpt-5.6-luna
# Adjudication model for contested dedup and anomaly disposition.
SARANA_LLM_MODEL_ADJUDICATION=gpt-5.6-sol
# Speech-to-text for citizen voice reports, with si/ta/en language hints.
SARANA_ASR_MODEL=gpt-transcribe
SARANA_EMBEDDING_MODEL=text-embedding-3-large
SARANA_EMBEDDING_DIMENSIONS=1024

# --- LangSmith (agent traces, PII-redacted) ---------------------------------
# OPTIONAL. Leave blank to disable tracing entirely.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sarana-local
LANGSMITH_TRACING=false

# --- Service base URLs (service-to-service calls) ---------------------------
# Host is the compose service name inside the stack, localhost outside it.
SARANA_CORE_API_URL=http://localhost:8001
SARANA_INCIDENT_SVC_URL=http://localhost:8002
SARANA_ALERTING_SVC_URL=http://localhost:8003
SARANA_LEDGER_SVC_URL=http://localhost:8004
SARANA_AGENT_SVC_URL=http://localhost:8005
SARANA_GOV_MOCK_URL=http://localhost:8006

# --- Government + telco mocks (file 11) -------------------------------------
# Simulated round-trip latency in milliseconds, applied to every mock response.
SARANA_GOV_MOCK_LATENCY_MS=250
# Fraction of mock calls that fail, 0.0-1.0. Exercises retry and fallback paths.
SARANA_GOV_MOCK_FAILURE_RATE=0.02
# Deterministic seed so a demo replays identically.
SARANA_GOV_MOCK_SEED=20251128

# --- Outbound notification email (Mailpit locally) --------------------------
SARANA_SMTP_HOST=localhost
SARANA_SMTP_PORT=1025
SARANA_SMTP_FROM=no-reply@sarana.lk

# --- Web apps (Next.js - must be NEXT_PUBLIC_ to reach the browser) ---------
NEXT_PUBLIC_SARANA_API_URL=http://localhost:8001
NEXT_PUBLIC_SARANA_ENV=local
# MapLibre GL style. Any style URL serving Sri Lanka at zoom 6-16.
NEXT_PUBLIC_SARANA_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# --- Mobile (Expo) -----------------------------------------------------------
# Must be your machine's LAN IP, not localhost - a phone cannot resolve localhost.
EXPO_PUBLIC_SARANA_API_URL=http://192.168.1.10:8001
EXPO_PUBLIC_SARANA_ENV=local
