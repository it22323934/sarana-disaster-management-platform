{
  "name": "@sarana/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "SARANA citizen app and Field Companion (offline-first)",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx ./e2e/run.ts",
    "verify-i18n": "tsx ./scripts/verify-i18n.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@maplibre/maplibre-react-native": "^11.3.10",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@sarana/ts-shared": "workspace:*",
    "@sarana/ui": "workspace:*",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "expo": "~57.0.16",
    "expo-application": "~57.0.2",
    "expo-audio": "~57.0.4",
    "expo-background-task": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.16",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.16",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-task-manager": "~57.0.16",
    "i18n-js": "^4.5.3",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.14.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  }
}
