{
  "name": "@sarana/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "SARANA citizen app and Field Companion (offline-first)",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform all",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sarana/ts-shared": "workspace:*",
    "expo": "~57.0.16",
    "expo-router": "~57.0.16",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  }
}
