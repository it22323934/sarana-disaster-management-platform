{
  "name": "@sarana/web-public",
  "version": "0.1.0",
  "private": true,
  "description": "SARANA public transparency dashboard",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "build:local": "node ./scripts/next-local.mjs build",
    "start": "next start --port 3001",
    "start:local": "node ./scripts/next-local.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:pii-sweep": "playwright test e2e/pii-sweep.spec.ts",
    "test:no-js": "playwright test e2e/no-js.spec.ts",
    "test:layout": "playwright test e2e/layout.spec.ts",
    "test:e2e": "playwright test",
    "verify-i18n": "tsx ./scripts/verify-messages.ts",
    "budget": "tsx ./scripts/js-budget.ts"
  },
  "dependencies": {
    "@sarana/ts-shared": "workspace:*",
    "@sarana/ui": "workspace:*",
    "maplibre-gl": "^5.0.0",
    "next": "^15.1.3",
    "next-intl": "^4.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "jsdom": "^25.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
